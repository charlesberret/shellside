---
import "../styles/site.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="site-name" href="/">Reference</a>
        <nav>
          <a href="/">Portfolio</a>
          <a href="/list.txt">Plaintext</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
