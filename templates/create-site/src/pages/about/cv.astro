---
import fs from "node:fs/promises";
import path from "node:path";
import yaml from "js-yaml";
import Base from "../../layouts/Base.astro";

const raw = yaml.load(
  await fs.readFile(path.join(process.cwd(), "src", "content", "cv.yaml"), "utf8"),
);
const sections = Array.isArray(raw) ? raw : [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="CV">
  <p class="meta"><a href={base}>Home</a></p>
  <h1>CV</h1>
  {
    sections.map((s: { title?: string; items?: string[] }) => (
      <section>
        <h2>{s.title}</h2>
        <ul>
          {(s.items ?? []).map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
