---
import { getCollection, render } from "astro:content";
import { isPublicItem, projectSiteTree } from "@shellside/site";
import EntryFields from "@shellside/site/EntryFields";
import Base from "../../layouts/Base.astro";
import path from "node:path";
import fs from "node:fs";

export async function getStaticPaths() {
  const tree = projectSiteTree(path.join(process.cwd(), "src", "content"));
  const paths = [];
  for (const section of tree.sections) {
    const hasCollection = fs.existsSync(path.join(process.cwd(), "src", "content", section.dir));
    // `dir/index.*` is the section's own landing page at /<dir>/.
    if (section.indexEntry && isPublicItem(section.indexEntry)) {
      paths.push({ params: { dir: section.dir, id: undefined }, props: { entry: section.indexEntry, section, hasCollection } });
    }
    for (const entry of section.entries) {
      if (!isPublicItem(entry)) continue;
      const id = entry.slug.slice(section.dir.length + 1);
      paths.push({ params: { dir: section.dir, id }, props: { entry, section, hasCollection } });
    }
  }
  return paths;
}

const { dir, id } = Astro.params;
const { entry, section, hasCollection } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

let Content: unknown = null;
if (hasCollection) {
  const coll = await getCollection(dir);
  const hit = coll.find((e) => e.id.replace(/\.(md|mdx|markdown)$/i, "") === (id ?? "index"));
  if (hit) Content = (await render(hit)).Content;
}
---

<Base title={entry.title ?? id}>
  <p class="meta"><a href={base}>Home</a> · <a href={`${base}plain/#${dir}`}>{section.title}</a></p>
  <h1>{entry.title ?? id}</h1>
  {entry.data.summary ? <p class="dek">{String(entry.data.summary)}</p> : null}
  <EntryFields data={entry.data} />
  {Content ? <Content /> : entry.body ? <pre class="catout">{entry.body}</pre> : null}
  {Array.isArray(entry.data.items) ? (
    <ul class="entries">
      {(entry.data.items as unknown[]).map((it) => (
        <li>{typeof it === "string" ? it : (it as {title?:string; summary?:string}).title ?? String(it)}{(it as {summary?:string}).summary ? <div>{String((it as {summary?:string}).summary)}</div> : null}</li>
      ))}
    </ul>
  ) : null}
  {entry.data.url ? <p><a href={String(entry.data.url)}>External link →</a></p> : null}
</Base>
