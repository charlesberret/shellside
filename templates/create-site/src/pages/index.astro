---
import Base from "../layouts/Base.astro";
import { projectSiteTree } from "@shellside/site";
import path from "node:path";

const tree = projectSiteTree(path.join(process.cwd(), "src", "content"));
const name = tree.site.name ?? "Site";
const dek = tree.site.shortBio ?? tree.site.tagline ?? "";
const isPublic = (e: { data: Record<string, unknown> }) =>
  e.data.visibility !== "draft" && !(e.data.visibility == null && ["draft", "unpublished"].includes(String(e.data.status)));
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title={name}>
  <h1>{name}</h1>
  {dek ? <p class="dek">{dek}</p> : null}

  {tree.entries.filter(isPublic).map((e) => (
    <section>
      <h2><a href={`${base}${e.slug}`}>{e.title}</a></h2>
    </section>
  ))}

  {tree.sections.map((s) => (
    <section>
      <h2 id={s.dir}>{s.title}</h2>
      {s.blurb ? <p class="meta">{s.blurb}</p> : null}
      <ul>
        {s.entries.filter(isPublic).map((e) => (
          <li>
            <a href={e.data.url ? String(e.data.url) : `${base}${e.slug}`}>{e.title ?? e.slug}</a>
            {e.data.summary ? <div>{String(e.data.summary)}</div> : null}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="meta">
    <a href={`${base}console`}>Console</a> · <a href={`${base}list.txt`}>Plaintext</a> · <a href={`${base}llms.txt`}>llms.txt</a>
  </p>
</Base>
