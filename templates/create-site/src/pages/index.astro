---
import config from "virtual:shellsite/config";
import { projectSiteTree } from "@shellside/site";
import path from "node:path";
import "../styles/site.css";


const tree = projectSiteTree(path.join(process.cwd(), "src", "content"));
const name = tree.site.name ?? config.identity.name ?? "Site";
const headline = tree.site.headline ?? tree.site.tagline ?? "";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
  </head>
  <body>
    <main class="gate">
      <h1 class="gate-name">{name}</h1>
      {
        headline ? (
          <p class="gate-headline">
            {headline.split("\n").map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))}
          </p>
        ) : null
      }
      <nav class="gate-nav">
        <a class="gate-btn" href={`${base}plain/`}>plain</a>
        <a class="gate-btn" href={`${base}console`}>console</a>
      </nav>
    </main>
  </body>
</html>
