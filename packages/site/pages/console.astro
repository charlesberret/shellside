---
/**
 * Packaged /console — a read-only shell over the public VFS.
 * Collections + identity come from `virtual:shellsite/config`;
 * lore/personality stays in the site's own console page if it has one.
 */
import { getCollection } from "astro:content";
import config from "virtual:shellsite/config";
import { byTitle, entryId, publicEntries } from "@shellside/site";
import {
  dir,
  file,
  projectCollections,
} from "@shellside/console-vfs";

function itemBody(item: { id: string; data: Record<string, unknown>; body?: string }): string {
  const meta = [
    item.data.kind,
    item.data.org,
    item.data.dates,
    item.data.venue,
    item.data.role,
    item.data.year,
    item.data.date,
  ]
    .filter((p) => p != null && p !== "")
    .join(" · ");
  const links = ((item.data.links ?? []) as { label?: string; href?: string }[])
    .map((l) => `  ${l.label ?? "link"}: ${l.href ?? ""}`)
    .join("\n");
  return [
    item.data.title ?? entryId(item),
    meta && `${meta}\n`,
    item.data.summary && `${item.data.summary}\n`,
    item.body,
    links && `links:\n${links}`,
  ]
    .filter(Boolean)
    .join("\n");
}

const collections = await Promise.all(
  (config.console?.collections ?? []).map(async (spec) => ({
    dir: spec.dir,
    ext: spec.ext ?? "txt",
    groupBySection: spec.groupBySection,
    sectionField: spec.sectionField,
    items: byTitle(publicEntries(await getCollection(spec.collection as never))).map((item) => ({
      slug: entryId(item),
      body: itemBody(item),
      url: spec.urlPrefix ? `${spec.urlPrefix}/${entryId(item)}` : undefined,
      section: spec.sectionField ? item.data[spec.sectionField] : item.data.type,
    })),
  })),
);

const name = config.identity.name;
const homeFiles: Record<string, ReturnType<typeof file>> = {
  "about.txt": file(`${name}${config.identity.tagline ? `\n\n${config.identity.tagline}` : ""}`),
  "readme.txt": file(
    "A console over the same public collections.\nls, cd, cat, pwd, tree, help. Portfolio view: /",
  ),
  ...Object.fromEntries(
    Object.entries(config.console?.homeFiles ?? {}).map(([k, v]) => [k, file(v)]),
  ),
};

const root = dir({ "~": dir({ ...homeFiles, ...projectCollections(collections) }) });
const fsJson = JSON.stringify(root).replace(/</g, "\\u003c");
---
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>console — {name}</title>
  <style>
    body { background: #0b0d12; color: #d8d8e0; font-family: ui-monospace, monospace; font-size: 14px; padding: 1.5rem; max-width: 72ch; margin: 0 auto; }
    #scrollback { white-space: pre-wrap; }
    .out { margin: 0 0 0.5rem; }
    #promptline { display: flex; gap: 0.5ch; margin-top: 0.5rem; }
    #cmd { flex: 1; font: inherit; border: 0; background: transparent; color: inherit; }
    #cmd:focus { outline: none; }
    a { color: #7d9fc7; }
    .hint { opacity: 0.6; font-size: 12px; }
  </style>
</head>
<body>
  <div id="scrollback"></div>
  <form id="promptline">
    <span id="prompt"></span>
    <input id="cmd" autocomplete="off" spellcheck="false" />
  </form>
  <p class="hint">read-only console · <a href="/">portfolio</a></p>
  <script is:inline define:vars={{ fsJson }}>
    const FS = JSON.parse(fsJson);
    const HOME = ["~"];
    let cwd = [...HOME];
    const scroll = document.getElementById("scrollback");
    const cmdEl = document.getElementById("cmd");
    const out = (text) => {
      const div = document.createElement("div");
      div.className = "out";
      div.textContent = text;
      scroll.append(div);
    };
    const prompt = () => `guest@ref ${cwd.join("/")} $`;
    const nodeAt = (parts) => {
      let n = FS;
      for (const p of parts) {
        if (!n || n.t !== "d" || !n.children[p]) return null;
        n = n.children[p];
      }
      return n;
    };
    const norm = (parts) => {
      const acc = [];
      for (const p of parts) {
        if (!p || p === ".") continue;
        if (p === "..") acc.pop();
        else acc.push(p);
      }
      return acc;
    };
    const resolve = (arg) =>
      norm(
        !arg
          ? cwd
          : arg === "~"
            ? HOME
            : arg.startsWith("~/")
              ? [...HOME, ...arg.slice(2).split("/")]
              : arg.startsWith("/")
                ? arg.slice(1).split("/")
                : [...cwd, ...arg.split("/")],
      );
    const walk = (node, indent) => {
      const lines = [];
      for (const [k, v] of Object.entries(node.children)) {
        lines.push(`${indent}${k}${v.t === "d" ? "/" : ""}`);
        if (v.t === "d") lines.push(...walk(v, indent + "  "));
      }
      return lines;
    };
    const run = (raw) => {
      out(`${prompt()} ${raw}`);
      const [cmd, ...args] = raw.trim().split(/\s+/);
      const arg = args.join(" ");
      if (cmd === "ls") {
        const node = nodeAt(resolve(arg));
        if (!node) return out(`ls: ${arg}: no such file or directory`);
        if (node.t !== "d") return out(arg);
        out(Object.keys(node.children).map((k) => (node.children[k].t === "d" ? k + "/" : k)).join("  "));
      } else if (cmd === "cd") {
        const parts = resolve(arg);
        const node = nodeAt(parts);
        if (!node || node.t !== "d") return out(`cd: ${arg}: not a directory`);
        cwd = parts;
      } else if (cmd === "pwd") {
        out("/" + cwd.slice(1).join("/"));
      } else if (cmd === "cat") {
        const node = nodeAt(resolve(arg));
        if (!node) return out(`cat: ${arg}: no such file`);
        if (node.t === "d") return out(`cat: ${arg}: is a directory`);
        if (node.t === "bin") return out(node.url);
        out(node.body || "");
        if (node.url) out(`\n→ ${node.url}`);
        for (const l of node.links || []) out(`→ ${l.label}: ${l.href}`);
      } else if (cmd === "tree") {
        out(walk(nodeAt(resolve(arg)) ?? FS, "").join("\n"));
      } else if (cmd === "help" || cmd === "?") {
        out("ls [dir] · cd <dir> · cat <file> · pwd · tree [dir] · clear · help");
      } else if (cmd === "clear") {
        scroll.innerHTML = "";
      } else if (cmd) {
        out(`${cmd}: command not found (try help)`);
      }
    };
    document.getElementById("promptline").addEventListener("submit", (e) => {
      e.preventDefault();
      run(cmdEl.value);
      cmdEl.value = "";
      cmdEl.focus();
    });
    run("help");
    run("ls");
  </script>
</body>
</html>
