---
/**
 * Packaged /console — a read-only shell over the public VFS.
 * Collections + identity come from `virtual:shellsite/config`;
 * lore/personality stays in the site's own console page if it has one.
 */
import { getCollection } from "astro:content";
import path from "node:path";
import config from "virtual:shellsite/config";
import { byTitle, entryId, projectSiteTree, publicEntries, type VfsNode } from "@shellside/site";
import {
  dir,
  file,
  projectCollections,
} from "@shellside/console-vfs";

function itemBody(item: { id: string; data: Record<string, unknown>; body?: string }): string {
  const meta = [
    item.data.kind,
    item.data.org,
    item.data.dates,
    item.data.venue,
    item.data.role,
    item.data.year,
    item.data.date,
  ]
    .filter((p) => p != null && p !== "")
    .join(" · ");
  const links = ((item.data.links ?? []) as { label?: string; href?: string }[])
    .map((l) => `  ${l.label ?? "link"}: ${l.href ?? ""}`)
    .join("\n");
  return [
    item.data.title ?? entryId(item),
    meta && `${meta}\n`,
    item.data.summary && `${item.data.summary}\n`,
    item.body,
    links && `links:\n${links}`,
  ]
    .filter(Boolean)
    .join("\n");
}

const collections = await Promise.all(
  (config.console?.collections ?? []).map(async (spec) => ({
    dir: spec.dir,
    ext: spec.ext ?? "txt",
    groupBySection: spec.groupBySection,
    sectionField: spec.sectionField,
    items: byTitle(publicEntries(await getCollection(spec.collection as never))).map((item) => ({
      slug: entryId(item),
      body: itemBody(item),
      url: spec.urlPrefix ? `${spec.urlPrefix}/${entryId(item)}` : undefined,
      section: spec.sectionField ? item.data[spec.sectionField] : item.data.type,
    })),
  })),
);

const base = import.meta.env.BASE_URL;
const name = config.identity.name;
const homeFiles: Record<string, ReturnType<typeof file>> = {
  "about.txt": file(`${name}${config.identity.tagline ? `\n\n${config.identity.tagline}` : ""}`),
  "readme.txt": file(
    "A console over the same public collections.\nls, cd, cat, pwd, tree, help. Portfolio view: /",
  ),
  ...Object.fromEntries(
    Object.entries(config.console?.homeFiles ?? {}).map(([k, v]) => [k, file(v)]),
  ),
};

/**
 * Filesystem-IA (docs/decisions/2026-10-17): dotfiles/hidden dirs live in
 * the console only. The site tree's `hidden` entries are merged under ~/
 * here — the page surface never sees them.
 */
const hiddenChildren: Record<string, VfsNode> = {};
const tree = projectSiteTree(path.resolve("src", "content"));
for (const h of tree.hidden) {
  const segs = h.path.replace(/^~\//, "").split("/");
  let scope = hiddenChildren;
  for (let i = 0; i < segs.length - 1; i++) {
    scope[segs[i]] ??= dir({});
    scope = (scope[segs[i]] as { children: Record<string, VfsNode> }).children;
  }
  scope[segs[segs.length - 1]] = file(h.body);
}
const root = dir({ "~": dir({ ...homeFiles, ...projectCollections(collections), ...hiddenChildren }) });
const fsJson = JSON.stringify(root).replace(/</g, "\\u003c");
const helpTopics = config.console?.helpTopics ?? {};
---
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>console — {name}</title>
  <style>
    body { background: #0b0d12; color: #d8d8e0; font-family: ui-monospace, monospace; font-size: 14px; padding: 1.5rem; max-width: 72ch; margin: 0 auto; }
    #scrollback { white-space: pre-wrap; }
    .out { margin: 0 0 0.5rem; }
    #promptline { display: flex; gap: 0.5ch; margin-top: 0.5rem; cursor: text; }
    #prompt { color: #7d9fc7; white-space: nowrap; }
    #cmd { flex: 1; font: inherit; border: 0; background: transparent; color: inherit; caret-color: #d8d8e0; }
    #cmd:focus { outline: none; }
    a { color: #7d9fc7; }
    .hint { opacity: 0.6; font-size: 12px; }
    .cyan { color: #7d9fc7; } .x { color: #c99a6b; } .red { color: #d97a7a; } .muted { opacity: 0.6; }
    .fs-entry { color: inherit; text-decoration: none; cursor: pointer; }
    .fs-entry:hover { text-decoration: underline; }
    #less-overlay { position: fixed; inset: 0; background: #0b0d12; z-index: 10; display: flex; flex-direction: column; padding: 1rem; }
    #less-overlay[hidden] { display: none; }
    #less-body { flex: 1; overflow-y: auto; white-space: pre-wrap; font: inherit; margin: 0.5rem 0 0; }
    .less-head { opacity: 0.7; border-bottom: 1px solid #333; padding-bottom: 0.4rem; }
  </style>
</head>
<body>
  <div id="scrollback"></div>
  <form id="promptline">
    <span id="prompt"></span>
    <input id="cmd" autocomplete="off" spellcheck="false" />
  </form>
  <p class="hint">read-only console · <a href={import.meta.env.BASE_URL.replace(/\/?$/, "/")}>home</a></p>
  <div id="vfs-data" data-json={fsJson} hidden />
  <div id="help-data" data-json={JSON.stringify(helpTopics)} hidden />
  <div id="less-overlay" hidden>
    <div class="less-head"><span id="less-title"></span> <span class="hint">— less: j/k scroll, q/Esc quits —</span></div>
    <pre id="less-body"></pre>
  </div>
  <script>
    import {
      createFsCommands,
      createFilterCommands,
      createHistory,
      createOutput,
      createRunner,
      createStickyScroll,
      completeLine,
      nodeAt as nodeAtFs,
      prettyPath,
      registerCommands,
      resolve as resolveSegments,
      resolvePath as resolvePathFs,
      DEFAULT_HOME,
    } from "@shellside/console-engine";

    const FS = JSON.parse(document.getElementById("vfs-data").dataset.json);
    const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
    const HOME = ["~"];
    let cwd = [...HOME];
    const scrollEl = document.body;
    const scrollbackEl = document.getElementById("scrollback");
    const promptlineEl = document.getElementById("promptline");
    const cmdEl = document.getElementById("cmd");
    const promptEl = document.getElementById("prompt");

    const esc = (s) =>
      String(s)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    const plainText = (html) =>
      String(html)
        .replace(/<[^>]*>/g, "")
        .replace(/&lt;/g, "<")
        .replace(/&gt;/g, ">")
        .replace(/&quot;/g, '"')
        .replace(/&nbsp;/g, " ")
        .replace(/&amp;/g, "&");

    // capture/pipe state for pipelines
    let pipeStdin = null;
    let capturing = false;
    let captureBuf = [];
    const setPipeStdin = (v) => { pipeStdin = v; };
    const getPipeStdin = () => pipeStdin;
    const beginCapture = () => { capturing = true; captureBuf = []; };
    const endCapture = () => { capturing = false; return captureBuf.join("\n"); };
    const resetPipe = () => { pipeStdin = null; capturing = false; captureBuf = []; };

    const sticky = createStickyScroll(() => scrollEl);
    const { out, blank } = createOutput({
      getScrollback: () => scrollbackEl,
      getPromptline: () => promptlineEl,
      scrollToPrompt: () => window.scrollTo(0, document.body.scrollHeight),
      isCapturing: () => capturing,
      pushCapture: (chunk) => captureBuf.push(chunk),
      plainText,
    });

    const host = document.title.replace(/^console — /, "") || "site";
    const prompt = () => `guest@${host.toLowerCase()} ${cwd.join("/")} $`;
    const paintPrompt = () => { promptEl.textContent = prompt(); };

    const nodeAt = (parts) => nodeAtFs(FS, parts);
    const resolvePath = (arg) => resolvePathFs(cwd, HOME, FS, arg);
    const resolveRel = (arg) => resolveSegments(cwd, HOME, arg);

    const HELP_TOPICS = JSON.parse(document.getElementById("help-data").dataset.json || "{}");
    const fileViewCmd = (name) => (/\.md$/i.test(name) ? "less" : "cat");
    const openExternal = (url) => {
      if (url.startsWith("/")) location.href = base.replace(/\/$/, "") + url;
      else window.open(url, "_blank", "noopener");
    };
    const lessOverlay = document.getElementById("less-overlay");
    const lessTitle = document.getElementById("less-title");
    const lessBody = document.getElementById("less-body");
    const openLess = (body, title) => {
      lessTitle.textContent = title || "";
      lessBody.textContent = body;
      lessOverlay.hidden = false;
      lessBody.scrollTop = 0;
    };
    const closeLess = () => { lessOverlay.hidden = true; cmdEl.focus(); };
    document.addEventListener("keydown", (e) => {
      if (lessOverlay.hidden) return;
      if (e.key === "q" || e.key === "Escape") closeLess();
      else if (e.key === "j" || e.key === "ArrowDown") lessBody.scrollTop += 40;
      else if (e.key === "k" || e.key === "ArrowUp") lessBody.scrollTop -= 40;
    });
    const rawTextFile = (pathArg, verb) => {
      const node = nodeAt(resolvePath(pathArg));
      if (!node) return { err: `${verb}: ${esc(pathArg)}: no such file`, cls: "red" };
      if (node.t === "d") return { err: `${verb}: ${esc(pathArg)}: is a directory`, cls: "red" };
      if (node.t === "bin") return { err: `${verb}: ${esc(pathArg)}: binary`, cls: "muted" };
      return { text: node.body ?? "" };
    };
    const readTextFile = (pathArg, verb) => {
      const r = rawTextFile(pathArg, verb);
      if (r.err) {
        if (r.err.includes("binary")) {
          const node = nodeAt(resolvePath(pathArg));
          if (node?.url) return { err: r.err, cls: "muted", openUrl: node.url, openLabel: pathArg };
        }
        return r;
      }
      return { body: `<pre class="catout">${esc(r.text)}</pre>` };
    };
    const walkVfs = (parts, opts = {}) => {
      const rows = [];
      const walk = (p, node) => {
        if (!node.children) return;
        for (const [name, child] of Object.entries(node.children)) {
          if (!opts.showHidden && name.startsWith(".")) continue;
          const cp = [...p, name];
          if (child.t === "f" || child.t === "bin") rows.push({ parts: cp, node: child, name });
          if (child.t === "d" && opts.recursive) walk(cp, child);
        }
      };
      walk(parts, nodeAt(parts) ?? {});
      return rows;
    };
    const lsShortEntry = (node, name, parentParts) => {
      const path = prettyPath([...parentParts, name]);
      const cmd = node.t === "d" ? "cd" : node.t === "bin" ? "open" : fileViewCmd(name);
      const label = node.t === "d" ? name + "/" : name;
      const cls = node.t === "d" ? " d" : node.t === "bin" ? " x" : "";
      return `<a href="#" class="fs-entry${cls}" data-fs-path="${esc(path)}" data-fs-cmd="${cmd}">${esc(label)}</a>`;
    };
    const lsLongRow = (node, name, parentParts) =>
      `<span class="muted">${node.t === "d" ? "drwx" : "-r--"}</span> ${lsShortEntry(node, name, parentParts)}`;

    const history = createHistory();
    const cmds = registerCommands(
      createFsCommands({
        out, esc,
        getCwd: () => cwd,
        setCwd: (p) => { cwd = p; paintPrompt(); },
        resolvePath, nodeAt, prettyPath,
        lsLongRow, lsShortEntry, readTextFile, fileViewCmd, openExternal, openLess,
      }),
      createFilterCommands({
        out, esc, getPipeStdin, rawTextFile, resolvePath, nodeAt, walkVfs, plainText, prettyPath,
      }),
      {
        clear() { scrollbackEl.textContent = ""; },
        help(args) {
          const topic = args[0] && HELP_TOPICS[args[0]];
          if (topic) { out(topic.long ?? topic); return; }
          const extra = Object.keys(HELP_TOPICS).length
            ? `\nSite commands: ${Object.keys(HELP_TOPICS).map((k) => `${k}${HELP_TOPICS[k].short ? ` — ${HELP_TOPICS[k].short}` : ""}`).join(", ")}`
            : "";
          out("ls · cd · cat · less · pwd · tree · open · find · grep · head · tail · wc · sort · uniq · diff · strings · echo · clear · help [topic]" + extra + "\nTab completes; ↑/↓ recalls history; | pipes.");
        },
        history() {
          // engine tracks history; enumerate is not exposed — keep it simple
          out('<span class="muted">history: use ↑/↓</span>');
        },
      },
    );

    const { run } = createRunner({
      isBusy: () => busy, setBusy: (v) => { busy = v; },
      bumpEpoch: () => ++epoch, abortedEpoch: (e) => e !== epoch,
      sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
      out,
      promptHtml: () => `<span class="cyan">${esc(prompt())}</span> `,
      esc,
      closeLess, clearCompletions: () => { compCycle = 0; compBase = null; },
      scrollToPrompt: () => window.scrollTo(0, document.body.scrollHeight),
      pushHistory: (cmd) => history.push(cmd),
      cmds,
      setPipeStdin, beginCapture, endCapture, resetPipe,
      prefersReducedMotion: () => matchMedia("(prefers-reduced-motion: reduce)").matches,
    });

    let busy = false;
    let epoch = 0;
    let compCycle = 0;
    let compBase = null;

    promptlineEl.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = cmdEl.value;
      cmdEl.value = "";
      compCycle = 0; compBase = null;
      run(v);
    });

    cmdEl.addEventListener("keydown", (e) => {
      if (e.key === "ArrowUp") {
        e.preventDefault();
        const prev = history.back(cmdEl.value);
        if (prev != null) cmdEl.value = prev;
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        const next = history.forward();
        if (next != null) cmdEl.value = next;
      } else if (e.key === "Tab") {
        e.preventDefault();
        if (compBase == null || !cmdEl.value.startsWith(compBase)) {
          compBase = cmdEl.value;
          compCycle = 0;
        }
        compCycle++;
        const r = completeLine(compBase, { cmds, fs: FS, cwd, home: HOME }, compCycle);
        cmdEl.value = r.line;
        if (r.matches.length > 1 && compCycle === 1) {
          out(`${esc(prompt())}${esc(compBase)}`);
          out(`<span class="muted">${esc(r.matches.join("  "))}</span>`);
        }
      } else {
        compCycle = 0; compBase = null;
      }
    });

    scrollbackEl.addEventListener("click", (e) => {
      const a = e.target.closest("[data-fs-path]");
      if (a) {
        e.preventDefault();
        run(`${a.dataset.fsCmd} ${a.dataset.fsPath}`, { echo: true, pace: false });
        return;
      }
      cmdEl.focus();
    });
    document.body.addEventListener("click", (e) => {
      if (!e.target.closest("#scrollback") && !e.target.closest("#less-overlay")) cmdEl.focus();
    });
    paintPrompt();
    cmdEl.focus();
    run("help", { pace: false });
    run("ls", { pace: false });
  </script>
</body>
</html>
